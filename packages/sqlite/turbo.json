{
  "extends": ["//"],
  "tags": ["infrastructure"],
  "tasks": {
    "db:prepare:disposable": {
      "tags": ["work:preparation"],
      "cache": false,
      "dependsOn": ["build"]
    },
    "db:prepare:test-product-data": {
      "tags": ["work:preparation"],
      "cache": false,
      "dependsOn": ["build"]
    },
    "db:push:disposable": {
      "tags": ["work:preparation"],
      "cache": false
    },
    "format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "tags": ["quality:light"]
    },
    "dev:build": {
      "dependsOn": ["^dev:build"],
      "cache": false,
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/packages/workspace-automation/scripts/build-development.ts"
      ],
      "outputs": [".turbo/development/**"],
      "tags": ["work:development"],
      "passThroughEnv": ["DIGITAL_DEVELOPMENT_*"]
    },
    "dev:compile": {
      "tags": ["work:development"],
      "cache": false,
      "outputs": [".turbo/development/**"],
      "passThroughEnv": ["DIGITAL_DEVELOPMENT_*"]
    }
  }
}
