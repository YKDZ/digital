{
  "name": "@digital/sqlite",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "digital-source": "./src/index.ts",
      "digital-development": "./.turbo/development/dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "digital-source": "./src/testing.ts",
      "digital-development": "./.turbo/development/dist/testing.js",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "db:prepare:disposable": "node ./dist/prepare-disposable.js",
    "db:prepare:test-product-data": "node ./dist/prepare-test-product-data.js",
    "db:push:disposable": "drizzle-kit push --config drizzle.config.ts",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "tsc -b tsconfig.build.json --force --pretty false",
    "dev:build": "pnpm --workspace-root run development:build @digital/sqlite",
    "dev:compile": "rm -rf .turbo/development && tsc -p tsconfig.build.json --customConditions digital-development --pretty false --incremental --outDir .turbo/development/dist --tsBuildInfoFile .turbo/development/build.tsbuildinfo"
  },
  "dependencies": {
    "@digital/application": "workspace:*",
    "@digital/domain": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@libsql/client": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
