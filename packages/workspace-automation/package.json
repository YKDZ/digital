{
  "name": "@digital/workspace-automation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts .",
    "lint:fix": "oxlint --format=unix --type-aware --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "development:controlled": "node --conditions=digital-source scripts/controlled-default.ts initialize"
  },
  "dependencies": {
    "@digital/environment": "workspace:*",
    "@digital/preview-corpus": "workspace:*",
    "@digital/public-api": "workspace:*",
    "@digital/test-support": "workspace:*",
    "@napi-rs/canvas": "^1.0.8"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
