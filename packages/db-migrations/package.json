{
  "name": "@digital/db-migrations",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "digital-db-migrate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "exports": {
    ".": {
      "digital-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "prepare-only": "pnpm build && node ./dist/cli.js prepare-only",
    "offline-restore": "pnpm build && node ./dist/cli.js offline-restore",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "pretest": "pnpm build",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@digital/product-data": "workspace:*",
    "@digital/sqlite": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
