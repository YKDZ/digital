{
  "extends": "@digital/typescript-config/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "customConditions": ["digital-source"],
    "erasableSyntaxOnly": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
