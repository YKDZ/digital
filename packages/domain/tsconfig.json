{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "target": "es2023",
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
