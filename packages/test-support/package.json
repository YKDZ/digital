{
  "name": "@digital/test-support",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "digital-source": "./src/index.ts",
      "digital-development": "./.turbo/development/dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./product-client": {
      "digital-source": "./src/product-client.ts",
      "digital-development": "./.turbo/development/dist/product-client.js",
      "types": "./dist/product-client.d.ts",
      "default": "./dist/product-client.js"
    },
    "./source-io": {
      "digital-source": "./src/source-io.ts",
      "digital-development": "./.turbo/development/dist/source-io.js",
      "types": "./dist/source-io.d.ts",
      "default": "./dist/source-io.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json --force --pretty false",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --reporter=verbose",
    "dev:build": "node --conditions=digital-source ../../scripts/build-development.ts"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
