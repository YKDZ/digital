{
  "extends": "@digital/typescript-config/base.json",
  "compilerOptions": {
    "customConditions": ["digital-source"],
    "declaration": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "target": "es2023",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "type-test/**/*.ts"]
}
