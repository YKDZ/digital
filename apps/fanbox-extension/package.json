{
  "name": "@digital/fanbox-extension",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./extension": "./dist"
  },
  "scripts": {
    "build": "vite build",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@digital/public-api": "workspace:*"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
