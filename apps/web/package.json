{
  "name": "@digital/web",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/assets/*": {
      "types": "./assets/*",
      "default": "./assets/*"
    },
    "#/components/*": {
      "types": "./components/*",
      "default": "./components/*"
    },
    "#/components/ui/*": {
      "types": "./components/ui/*/index.ts",
      "default": "./components/ui/*/index.ts"
    },
    "#/composables/*": {
      "types": "./composables/*.ts",
      "default": "./composables/*.ts"
    },
    "#/lib/*": {
      "types": "./lib/*.ts",
      "default": "./lib/*.ts"
    },
    "#/server/*": {
      "types": "./server/*.ts",
      "default": "./server/*.ts"
    }
  },
  "scripts": {
    "build": "vike build",
    "deployment": "node --conditions=digital-source scripts/check-standalone-deployment.ts && node --conditions=digital-source scripts/check-compose-deployment.ts",
    "dev": "node --conditions=digital-source ../../scripts/development-environment.ts",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts .",
    "lint:fix": "oxlint --type-aware --format=unix --config ../../oxlint.config.ts . --fix",
    "preview": "vike preview",
    "pretest": "pnpm --filter @digital/sqlite build",
    "start": "node ./dist/server/index.mjs",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:e2e": "node scripts/run-playwright.ts",
    "test:e2e:managed-service": "node scripts/run-managed-service-acceptance.ts --mode owned",
    "test:e2e:provided-service": "node scripts/run-managed-service-acceptance.ts --mode provided",
    "typecheck": "node --conditions=digital-source scripts/run-vue-tsc.ts --build --noEmit --pretty false",
    "dev:serve": "node --conditions=digital-source ../../scripts/development-task.ts"
  },
  "dependencies": {
    "@digital/composition": "workspace:*",
    "@digital/presentation": "workspace:*",
    "@digital/test-support": "workspace:*",
    "@digital/web-delivery": "workspace:*",
    "@lucide/vue": "^1.27.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vikejs/hono": "catalog:",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "reka-ui": "^2.10.1",
    "srvx": "catalog:",
    "tailwind-merge": "^3.7.0",
    "vike": "catalog:",
    "vike-vue": "catalog:",
    "vue": "catalog:",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@digital/application": "workspace:*",
    "@digital/environment": "workspace:*",
    "@digital/typescript-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.3.4"
}
