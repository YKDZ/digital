{
  "name": "@digital/web",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": {
      "default": "./*.ts",
      "types": "./*.ts"
    }
  },
  "scripts": {
    "build": "vike build",
    "deployment": "node scripts/check-standalone-deployment.ts && node scripts/check-compose-deployment.ts",
    "dev": "vike dev",
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --type-aware --config ../../oxlint.config.ts .",
    "lint:fix": "oxlint --type-aware --format=unix --config ../../oxlint.config.ts . --fix",
    "preview": "vike preview",
    "pretest": "pnpm --filter @digital/sqlite build",
    "pretest:e2e": "node ../../scripts/build-production-workspace.mjs",
    "start": "node ./dist/server/index.mjs",
    "test": "vitest run --reporter=agent --silent=passed-only --passWithNoTests",
    "test:e2e": "node scripts/run-playwright.ts",
    "typecheck": "node scripts/run-vue-tsc.ts --build --noEmit --pretty false"
  },
  "dependencies": {
    "@digital/application": "workspace:*",
    "@digital/composition": "workspace:*",
    "@digital/presentation": "workspace:*",
    "@lucide/vue": "^1.27.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vikejs/hono": "catalog:",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "catalog:",
    "reka-ui": "^2.10.1",
    "srvx": "catalog:",
    "tailwind-merge": "^3.6.0",
    "vike": "catalog:",
    "vike-vue": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tailwindcss": "catalog:",
    "turbo": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.17.0"
}
