{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": { "#/*": ["./*"] },
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "test/**/*.ts",
    "composables/**/*.ts",
    "server/**/*.ts",
    "lib/**/*.ts",
    "vitest.config.ts"
  ]
}
