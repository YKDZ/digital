            "ordinal": 7,
            "type": "p",
            "value": {
              "type": "p",
              "text": "試しに作った1分ほどの動画ですが、せっかく作りましたので置いておきます。"
            }
          },
          {
            "ordinal": 8,
            "type": "p",
            "value": {
              "type": "p",
              "text": "来年にはまた別の新しい動画を作成する予定です。"
            }
          },
