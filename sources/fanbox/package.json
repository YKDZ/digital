{
  "name": "@digital/fanbox",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "digital-source": "./src/public.ts",
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./testing": {
      "digital-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --reporter=verbose",
    "build": "tsc -b tsconfig.build.json --force --pretty false"
  },
  "dependencies": {
    "@digital/application": "workspace:*",
    "@digital/domain": "workspace:*",
    "playwright": "1.62.0"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
