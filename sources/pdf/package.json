{
  "name": "@digital/pdf",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "digital-source": "./src/index.ts",
      "digital-development": "./.turbo/development/dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format:check": "oxfmt --list-different --config ../../oxfmt.config.ts .",
    "format:write": "oxfmt --write --config ../../oxfmt.config.ts .",
    "lint": "oxlint --quiet --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix --config ../../oxlint.config.ts --ignore-pattern node_modules . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --reporter=verbose",
    "build": "tsc -b tsconfig.build.json --force --pretty false",
    "dev:build": "node --conditions=digital-source ../../scripts/build-development.ts"
  },
  "dependencies": {
    "@digital/application": "workspace:*",
    "@digital/domain": "workspace:*",
    "@napi-rs/canvas": "^1.0.8",
    "@xmldom/xmldom": "^0.9.12",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@digital/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
