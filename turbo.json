{
  "boundaries": {
    "tags": {
      "application": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "composition": {
        "dependencies": {
          "allow": [
            "tooling",
            "integration",
            "infrastructure",
            "application",
            "domain",
            "test-support"
          ]
        }
      },
      "delivery": {
        "dependencies": {
          "allow": [
            "delivery",
            "presentation",
            "application",
            "domain",
            "test-support",
            "tooling"
          ]
        }
      },
      "composition-root": {
        "dependencies": {
          "allow": [
            "composition-root",
            "composition",
            "delivery",
            "presentation",
            "application",
            "domain",
            "integration",
            "infrastructure",
            "test-support",
            "tooling",
            "environment"
          ]
        }
      },
      "domain": {
        "dependencies": {
          "allow": ["domain", "test-support", "tooling"]
        }
      },
      "environment": {
        "dependencies": {
          "allow": ["tooling"]
        }
      },
      "infrastructure": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "integration": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "presentation": {
        "dependencies": {
          "allow": [
            "presentation",
            "application",
            "domain",
            "test-support",
            "tooling"
          ]
        }
      },
      "test-support": {
        "dependencies": {
          "allow": ["test-support", "tooling"]
        }
      },
      "tooling": {
        "dependencies": {
          "allow": [
            "tooling",
            "integration",
            "infrastructure",
            "application",
            "domain",
            "test-support"
          ]
        }
      }
    }
  },
  "tasks": {
    "//#boundaries": {
      "tags": ["quality:light"],
      "cache": false,
      "passThroughEnv": ["CI"]
    },
    "//#db:migrate": {
      "tags": ["work:preparation"],
      "cache": false
    },
    "//#environment": {
      "tags": ["work:on-demand"],
      "cache": false
    },
    "//#check": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#fix": {
      "tags": ["work:repair"],
      "cache": false
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "dependsOn": ["//#lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#preview": {
      "tags": ["work:development"],
      "cache": false
    },
    "//#preview:verify": {
      "tags": ["quality:heavy"],
      "cache": false,
      "dependsOn": [
        "@digital/web#build",
        "@digital/cli#build",
        "@digital/db-migrations#build"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP", "DIGITAL_CI_EVIDENCE"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#preview:dev": {
      "tags": ["work:development"],
      "cache": false,
      "passThroughEnv": ["DIGITAL_DEVELOPMENT_*"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#check:full": {
      "tags": ["quality:entry"],
      "cache": false
    },
    "//#test": {
      "tags": ["quality:light"],
      "cache": false,
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "//#development:build": {
      "tags": ["work:development"],
      "cache": false,
      "passThroughEnv": ["DIGITAL_DEVELOPMENT_*"]
    },
    "//#development:serve": {
      "tags": ["work:development"],
      "cache": false,
      "passThroughEnv": ["DIGITAL_DEVELOPMENT_*"]
    },
    "//#acceptance:prepare": {
      "tags": ["work:preparation"],
      "cache": false,
      "passThroughEnv": ["DIGITAL_CI_EVIDENCE"]
    },
    "//#verify:audio-posts": {
      "tags": ["quality:conditional"],
      "cache": false,
      "dependsOn": [
        "@digital/web#build",
        "@digital/cli#build",
        "@digital/db-migrations#build"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "//#verify:publication-screen": {
      "tags": ["quality:conditional"],
      "cache": false,
      "dependsOn": [
        "@digital/web#build",
        "@digital/cli#build",
        "@digital/db-migrations#build"
      ],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "//#fixture:source-io": {
      "tags": ["work:on-demand"],
      "cache": false
    },
    "//#fixture:fanbox-session": {
      "tags": ["work:on-demand"],
      "cache": false
    }
  }
}
