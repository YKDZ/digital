{
  "boundaries": {
    "tags": {
      "application": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "composition": {
        "dependencies": {
          "allow": [
            "tooling",
            "integration",
            "infrastructure",
            "application",
            "domain",
            "test-support"
          ]
        }
      },
      "delivery": {
        "dependencies": {
          "allow": [
            "delivery",
            "presentation",
            "application",
            "domain",
            "test-support",
            "tooling"
          ]
        }
      },
      "composition-root": {
        "dependencies": {
          "allow": [
            "composition-root",
            "composition",
            "delivery",
            "presentation",
            "application",
            "domain",
            "integration",
            "infrastructure",
            "test-support",
            "tooling",
            "environment"
          ]
        }
      },
      "domain": {
        "dependencies": {
          "allow": ["domain", "test-support", "tooling"]
        }
      },
      "environment": {
        "dependencies": {
          "allow": ["tooling"]
        }
      },
      "infrastructure": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "integration": {
        "dependencies": {
          "allow": ["application", "domain", "test-support", "tooling"]
        }
      },
      "presentation": {
        "dependencies": {
          "allow": [
            "presentation",
            "application",
            "domain",
            "test-support",
            "tooling"
          ]
        }
      },
      "test-support": {
        "dependencies": {
          "allow": ["test-support", "tooling"]
        }
      },
      "tooling": {
        "dependencies": {
          "allow": [
            "tooling",
            "integration",
            "infrastructure",
            "application",
            "domain",
            "test-support"
          ]
        }
      }
    }
  },
  "tasks": {
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#format:write": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#lint:fix": {
      "cache": false
    },
    "//#typecheck": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/fixtures/controlled-source-io/**",
        "$TURBO_ROOT$/fixtures/controlled-fanbox-session/**",
        "$TURBO_ROOT$/fixtures/live-corpus/**"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["TMPDIR", "TMP", "TEMP"]
    },
    "test:corpus-real": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "TMPDIR",
        "TMP",
        "TEMP",
        "DIGITAL_TMDB_ACCESS_TOKEN",
        "DIGITAL_OMDB_API_KEY",
        "DIGITAL_BANGUMI_LIVE_PRODUCT_DATA",
        "DIGITAL_BANGUMI_CLIENT_ID",
        "DIGITAL_BANGUMI_CLIENT_SECRET",
        "DIGITAL_BANGUMI_REDIRECT_URI",
        "DIGITAL_FANBOX_LIVE_FAILURE_EVIDENCE_PATH"
      ]
    },
    "test:e2e:tmdb-omdb-live": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["DIGITAL_TMDB_ACCESS_TOKEN", "DIGITAL_OMDB_API_KEY"]
    },
    "test:e2e:bangumi-live": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "DIGITAL_BANGUMI_LIVE_PRODUCT_DATA",
        "DIGITAL_BANGUMI_CLIENT_ID",
        "DIGITAL_BANGUMI_CLIENT_SECRET",
        "DIGITAL_BANGUMI_REDIRECT_URI"
      ]
    },
    "test:e2e:managed-service": {
      "dependsOn": ["@digital/web#build", "@digital/environment#build"],
      "cache": false,
      "passThroughEnv": [
        "DIGITAL_ACCEPTANCE_LEDGER",
        "DIGITAL_ACCEPTANCE_ARTIFACTS"
      ]
    },
    "test:e2e:provided-service": {
      "dependsOn": ["@digital/web#build"],
      "cache": false,
      "passThroughEnv": [
        "DIGITAL_ACCEPTANCE_BASE_URL",
        "DIGITAL_ACCEPTANCE_LEDGER",
        "DIGITAL_ACCEPTANCE_ARTIFACTS"
      ]
    },
    "deployment": {
      "cache": false,
      "passThroughEnv": [
        "DIGITAL_DEPLOYMENT_*",
        "DIGITAL_COMPOSE_CHECK_*",
        "DIGITAL_DEPLOYMENT_PLAYWRIGHT_CLIENT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    "dev:build": {
      "dependsOn": ["^dev:build"],
      "cache": false,
      "inputs": [
        "src/**",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/build-development.ts"
      ],
      "outputs": [".turbo/development/**"]
    },
    "dev:serve": {
      "dependsOn": ["^dev:build"],
      "cache": false,
      "inputs": [
        "package.json",
        "vite.config.ts",
        "+server.ts",
        "scripts/start-development.ts",
        "server/**",
        "pages/**/+*.ts",
        "$TURBO_ROOT$/scripts/development-task.ts"
      ],
      "passThroughEnv": [
        "DIGITAL_DEVELOPMENT_SESSION",
        "DIGITAL_DEVELOPMENT_WORKSPACE",
        "DIGITAL_DEVELOPMENT_ENVIRONMENT"
      ]
    }
  }
}
