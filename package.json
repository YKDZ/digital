{
  "name": "digital",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "boundaries": "node --conditions=digital-source scripts/run-turbo-boundaries.ts && node --conditions=digital-source scripts/check-toolchain-versions.ts",
    "db:migrate": "pnpm --filter @digital/db-migrations prepare-only",
    "environment": "pnpm --filter @digital/environment cli",
    "product:maintenance": "pnpm --silent --filter @digital/product-maintenance --fail-if-no-match run cli",
    "check": "node --conditions=digital-source scripts/task-gates.ts check",
    "fix": "node --conditions=digital-source scripts/task-gates.ts fix",
    "format:check": "oxfmt --list-different --config oxfmt.config.ts package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .gitignore .dockerignore docker-compose.yml .vscode .github .devcontainer scripts",
    "format:write": "oxfmt --write --config oxfmt.config.ts package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .gitignore .dockerignore docker-compose.yml .vscode .github .devcontainer scripts",
    "lint": "oxlint --quiet --format=unix --type-aware --config oxlint.config.ts *.config.ts scripts",
    "lint:fix": "oxlint --format=unix --type-aware --config oxlint.config.ts *.config.ts scripts --fix",
    "preview:verify": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" DIGITAL_AUTOMATION_SOURCE_DIRECTORY=\"$PWD/fixtures/controlled-source-io\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/preview-environment.ts verify",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "preview:dev": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/development-environment.ts",
    "check:heavy": "node --conditions=digital-source scripts/task-gates.ts check:heavy",
    "check:full": "node --conditions=digital-source scripts/task-gates.ts check:full",
    "test": "node --test scripts/test/*.test.ts",
    "development:build": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/build-development.ts",
    "development:controlled": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" node --conditions=digital-source scripts/controlled-development.ts",
    "development:serve": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/development-task.ts",
    "verify:controlled-default": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/controlled-default.ts verify",
    "verify:audio-posts": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" DIGITAL_AUTOMATION_SOURCE_DIRECTORY=\"$PWD/fixtures/preview-corpus/audio-posts\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-audio-post-corpus.ts",
    "verify:publication-screen": "DIGITAL_AUTOMATION_WORKSPACE=\"$PWD\" DIGITAL_AUTOMATION_SOURCE_DIRECTORY=\"$PWD/fixtures/preview-corpus/publication-screen\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-publication-screen-corpus.ts",
    "verify:bangumi-live": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-bangumi-live.ts",
    "verify:dlsite-eight-live": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-dlsite-eight-live.ts",
    "verify:tmdb-omdb-live": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-tmdb-omdb-live.ts",
    "verify:fanbox-five-live": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-fanbox-five-live.ts",
    "verify:publications-live": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-publications-live.ts",
    "verify:deep-integrity": "DIGITAL_AUTOMATION_WORKSPACE=\"${DIGITAL_AUTOMATION_WORKSPACE:-$PWD}\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/verify-deep-corpus-integrity.ts",
    "fixture:source-io": "DIGITAL_AUTOMATION_OUTPUT_DIRECTORY=\"$PWD/fixtures/controlled-source-io\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/build-controlled-source-io-fixture.ts",
    "fixture:fanbox-session": "DIGITAL_AUTOMATION_OUTPUT_DIRECTORY=\"$PWD/fixtures/controlled-fanbox-session\" pnpm --filter @digital/workspace-automation exec node --conditions=digital-source scripts/build-controlled-fanbox-session-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
